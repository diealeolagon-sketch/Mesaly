{
    "name": "mesaly/mesaly",
    "description": "SaaS de menús digitales interactivos con pedidos por WhatsApp para restaurantes en Colombia",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Mesaly Dev Team",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "chillerlan/php-qrcode": "^5.0",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
