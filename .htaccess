<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso directo a archivos sensibles de la raíz
    <FilesMatch "(^\.env|composer\.(json|lock)|phpunit\.xml|README\.md)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Redireccionar el tráfico hacia la carpeta public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
