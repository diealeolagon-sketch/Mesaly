# ==============================================================================
# MESALY — Entorno de Configuración
# ==============================================================================

# Configuración de la Aplicación
APP_NAME=Mesaly
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Mesaly/public
APP_TIMEZONE=America/Bogota

# Base de Datos (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mesaly
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Parámetros Globales de Suscripción (Días)
SUBSCRIPTION_ALERT_DAYS=5
SUBSCRIPTION_GRACE_DAYS=3

# Contacto de Soporte de la Plataforma (para WhatsApp wa.me)
SUPPORT_WHATSAPP=573228991339

# Seguridad de Sesión
SESSION_LIFETIME=7200
TABLE_SESSION_LIFETIME=14400

# Factus API V2 - Solo Sandbox (nunca confirmar credenciales reales al repositorio)
FACTUS_ENV=sandbox
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
# Generar 32 bytes aleatorios: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
FACTUS_TOKEN_ENCRYPTION_KEY=
FACTUS_CONNECT_TIMEOUT=5
FACTUS_TIMEOUT=30
FACTUS_TOKEN_LEEWAY=120
