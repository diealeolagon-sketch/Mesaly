<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso a archivos ocultos (iniciados con punto)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Si el archivo o directorio existe físicamente, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Reescribir todo lo demás a index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Cabeceras de seguridad a nivel de servidor web
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
